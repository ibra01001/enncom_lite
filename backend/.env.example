# ==============================================================================
# Backend Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & ENVIRONMENT
# ------------------------------------------------------------------------------
# Application environment ('production' or 'development')
FLASK_ENV=production

# Enable/disable debug mode (MUST be 0 or false in production!)
FLASK_DEBUG=0

# Host binding (0.0.0.0 is required inside Docker and cloud containers)
HOST=0.0.0.0

# Port the backend listens on (often automatically provided by cloud PaaS like Render/Railway/Heroku/Cloud Run)
PORT=5000

# Secret key used for cryptographic signing of sessions/tokens.
# Generate one using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# ------------------------------------------------------------------------------
# 2. CORS & SECURITY
# ------------------------------------------------------------------------------
# Allowed origins for HTTP requests and Socket.IO WebSocket connections.
# In development, you can use '*'
# In production, set this to your exact frontend domain(s), separated by commas:
# Example: https://chat.yourdomain.com,https://yourdomain.com
CORS_ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 3. REDIS CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Full Redis Connection URL (recommended for Cloud Redis like Upstash, Redis Cloud, Render, Railway, AWS ElastiCache)
# Example: redis://default:yourpassword@redis-host.com:6379/0
# For TLS/SSL enabled Redis, use rediss://...
# REDIS_URL=redis://default:password@localhost:6379/0

# Option B: Individual host/port parameters (used when REDIS_URL is not set)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# ------------------------------------------------------------------------------
# 4. WEBSOCKET / SOCKET.IO HORIZONTAL SCALING (OPTIONAL)
# ------------------------------------------------------------------------------
# If running multiple backend instances/containers or multi-worker Gunicorn,
# set this Redis queue URL to synchronize Socket.IO events across workers.
# SOCKETIO_MESSAGE_QUEUE=redis://redis:6379/1

# ------------------------------------------------------------------------------
# 5. APPLICATION TUNING & LIMITS
# ------------------------------------------------------------------------------
# Redis key prefix for public chat history
PUBLIC_CHAT_KEY=chat:messages:public

# Maximum number of messages kept in room history
MAX_HISTORY=50

# Time-To-Live in seconds for temporary session tokens and room states (86400 = 24h)
TTL_SECONDS=86400

# Maximum incoming message payload size in bytes (65536 = 64 KB)
MAX_MSG_BYTES=65536

# Maximum number of pre-published MLS KeyPackages buffered per user
MAX_KEY_PACKAGES=50

# Maximum number of MLS commit history records kept for epoch catch-up
MAX_COMMIT_HISTORY=30
