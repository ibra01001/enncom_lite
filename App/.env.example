# ==============================================================================
# Frontend Environment Configuration (.env.example)
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT API & WEBSOCKET URL (Vite Browser Access)
# ------------------------------------------------------------------------------
# In PRODUCTION (e.g. Vercel dashboard):
# Set this to the public HTTPS URL where your backend is hosted.
# Example: https://enccom-backend.onrender.com or https://api.yourdomain.com
#
# In DEVELOPMENT:
# Leave empty to automatically route through the Vite proxy (works with localhost, LAN IP, and Docker).
VITE_API_URL=

# ------------------------------------------------------------------------------
# 2. LOCAL DEV SERVER PROXY TARGET (Node.js Build / Dev Server only)
# ------------------------------------------------------------------------------
# Only used by vite.config.ts for the local development reverse proxy.
# Ignored during production static builds.
# Defaults to http://localhost:5000 if empty.
# In Docker Compose, this is set to http://backend:5000.
BACKEND_URL=
..